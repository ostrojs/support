{
    "name": "@ostro/support",
    "version": "2.0.0-alpha.2",
    "description": "Support for OstroJS",
    "main": "build/function.js",
    "types": "build/types/function.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/types/function.d.ts",
            "default": "./build/function.js"
        },
        "./*": {
            "types": "./build/types/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.2",
        "fs-extra": "^11.4.1",
        "lodash": "^4.17.21",
        "luxon": "^2.0.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "ostro support",
        "helper functions",
        "nodejs helpers",
        "ostrojs helpers",
        "ostro",
        "support"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/support.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/support/issues"
    },
    "homepage": "https://github.com/ostrojs/support#readme",
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.0"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
